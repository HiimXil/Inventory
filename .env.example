# PostgreSQL connection string used by lib/db/client.ts (Prisma).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sqp_inventaire

# Base URL Auth.js uses to reconstruct its internal /api/auth/session calls.
NEXTAUTH_URL=http://localhost:3000

# Signing/encryption secret for Auth.js sessions (authOptions.secret).
# Generate a real value for any non-throwaway environment, e.g.:
#   openssl rand -base64 32
NEXTAUTH_SECRET=change-this-secret-to-a-secure-value

# How theoretical stock is imported at session preparation. "mock" (simulated
# fixtures, dev/test default) or "file" (real path — parses a user-provided
# ARTIS .xlsx export, production default). "http" is a documented but
# unimplemented adapter — see RUNBOOK.md §7.
ARTIS_MODE=mock

# Which mock fixture ARTIS_MODE=mock serves: normal | empty | malformed | paginated.
ARTIS_FIXTURE=normal

NODE_ENV=development

# Reserved for the future ArtisHttpAdapter (ARTIS_MODE=http) — not read by
# any code today. Leave unset until that mode is actually implemented; never
# put real ARTIS API credentials in a committed file.
# ARTIS_BASE_URL=
# ARTIS_USER=
# ARTIS_PASSWORD=

# Overrides the demo accounts' password created by `npm run db:seed`
# (default: Password123!, a publicly documented demo value — see RUNBOOK.md
# §4). Set this if seeding a shared/CI database where you don't want the
# well-known default.
# SEED_DEMO_PASSWORD=

# RGPD purge retention window in months (npm run purge:rgpd). Defaults to 24
# if unset or invalid.
# RGPD_RETENTION_MONTHS=24
