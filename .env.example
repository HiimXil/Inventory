# PostgreSQL connection string used by lib/db/client.ts (Prisma).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sqp_inventaire

# Base URL Auth.js uses to reconstruct its internal /api/auth/session calls.
NEXTAUTH_URL=http://localhost:3000

# Signing/encryption secret for Auth.js sessions (authOptions.secret).
# Generate a real value for any non-throwaway environment, e.g.:
#   openssl rand -base64 32
NEXTAUTH_SECRET=change-this-secret-to-a-secure-value

# How theoretical stock is imported at session preparation. Real default
# EVERYWHERE a human uses the app (dev and production alike) is "file" —
# requires uploading an ARTIS .xlsx export at preparation time (see
# lib/artis/file.ts). "mock" (simulated fixtures, no file needed) only ever
# applies automatically inside the test suites (Vitest/Playwright force it
# themselves — see lib/artis/factory.ts's resolveArtisMode()), never as a
# side effect of what's in this file. "http" is a documented but
# unimplemented adapter — see RUNBOOK.md §7.
#
# Leave this unset to get the real "file" default. Only set it if you
# specifically want to override that (e.g. ARTIS_MODE=mock for a quick local
# smoke test without a real export file in hand).
# ARTIS_MODE=file

# Which mock fixture ARTIS_MODE=mock serves: normal | empty | malformed | paginated.
ARTIS_FIXTURE=normal

NODE_ENV=development

# Reserved for the future ArtisHttpAdapter (ARTIS_MODE=http) — not read by
# any code today. Leave unset until that mode is actually implemented; never
# put real ARTIS API credentials in a committed file.
# ARTIS_BASE_URL=
# ARTIS_USER=
# ARTIS_PASSWORD=

# Overrides the demo accounts' password created by `npm run db:seed`
# (default: Password123!, a publicly documented demo value — see RUNBOOK.md
# §4). Set this if seeding a shared/CI database where you don't want the
# well-known default.
# SEED_DEMO_PASSWORD=

# RGPD purge retention window in months (npm run purge:rgpd). Defaults to 24
# if unset or invalid.
# RGPD_RETENTION_MONTHS=24

# ---------------------------------------------------------------------------
# docker-compose.yml / Portainer stack only — not read by `npm run dev`.
# See DEPLOY.md for the full deployment walkthrough.
# ---------------------------------------------------------------------------

# Password for Postgres's own superuser ("postgres"), used only by the
# entrypoint's migrate/seed steps (MIGRATE_DATABASE_URL) — the running app
# never connects with this. Generate with e.g. `openssl rand -hex 24`
# (avoid a single quote in the value).
POSTGRES_PASSWORD=

# Optional: overrides the default database name (sqp_inventaire) used by
# both the db and app services in docker-compose.yml.
# POSTGRES_DB=sqp_inventaire

# Password for the unprivileged "sqp_app" Postgres role the *running app*
# actually connects as (FR-032 — cannot UPDATE/DELETE AuditLog). Set once;
# the entrypoint re-applies it with ALTER ROLE on every boot. Generate with
# e.g. `openssl rand -hex 24` (avoid a single quote in the value).
SQP_APP_PASSWORD=

# Name of the pre-existing external Docker network shared with Nginx Proxy
# Manager, so NPM can route to the "app" service by name. Defaults to
# npm_proxy if unset — see DEPLOY.md §"Réseau partagé avec NPM".
# NPM_NETWORK_NAME=npm_proxy
